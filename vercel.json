{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/config/apikey",
      "destination": "/api/config/apikey.js"
    },
    {
      "source": "/inspector.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/officer.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/report.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
